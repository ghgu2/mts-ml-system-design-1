    {
      "title": "Смена версии модели",
      "type": "timeseries",
      "description": "Отметка длится 30 секунд с момента подхвата новой версии. В легенде указана версия.",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hw11-prometheus"
          },
          "expr": "((time() - fraud_scoring_model_switch_timestamp_seconds < 30) >= bool 0) or label_replace(vector(0), \"model_version\", \"Без смены\", \"__name__\", \".*\")",
          "legendFormat": "{{model_version}}",
          "format": "time_series",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 65,
            "drawStyle": "bars",
            "axisPlacement": "left"
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 6
    },
    {
      "title": "Результаты по версиям модели",
      "type": "table",
      "description": "Число сохранённых скоров и доля фродовых флагов в выбранном диапазоне времени.",
      "datasource": {
        "type": "postgres",
        "uid": "hw11-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hw11-postgres"
          },
          "rawSql": "SELECT model_version AS \"Версия модели\", COUNT(*) AS \"Скоры\",\n       AVG(fraud_flag)::double precision AS \"Доля фрода\"\nFROM scoring.scores\nWHERE $__timeFilter(scored_at)\nGROUP BY model_version\nORDER BY MAX(scored_at) DESC",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Доля фрода"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 7
    },
    {
      "title": "Плотность скоров по штату и мерчанту",
      "type": "barchart",
      "description": "Доля скоров в интервале, делённая на его ширину 0,05. Учитываются оба фильтра.",
      "datasource": {
        "type": "postgres",
        "uid": "hw11-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hw11-postgres"
          },
          "rawSql": "WITH counts AS (\n    SELECT LEAST(FLOOR(score * 20)::int, 19) AS bucket, COUNT(*) AS n\n    FROM scoring.scores\n    WHERE $__timeFilter(scored_at)\n  AND ('__all__' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring}))\n  AND ('__all__' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring}))\n    GROUP BY 1\n)\nSELECT TO_CHAR(bucket / 20.0, 'FM0.00') || '–' ||\n       TO_CHAR((bucket + 1) / 20.0, 'FM0.00') AS \"Интервал скора\",\n       COALESCE(20.0 * counts.n / NULLIF(SUM(counts.n) OVER (), 0), 0)::double precision AS \"Плотность\"\nFROM generate_series(0, 19) AS buckets(bucket)\nLEFT JOIN counts USING (bucket)\nORDER BY bucket",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "xField": "Интервал скора",
        "orientation": "auto",
        "xTickLabelRotation": -30,
        "groupWidth": 0.85,
        "barWidth": 0.92,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "showValue": "never"
      },
      "id": 8
    },
    {
      "title": "TPS по штату и мерчанту",
      "type": "timeseries",
      "description": "Сохранённые результаты сгруппированы по времени их публикации в Kafka. Учитываются оба фильтра.",
      "datasource": {
        "type": "postgres",
        "uid": "hw11-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hw11-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(scored_at, $__interval, 0),\n       (COUNT(*) * 1000.0 / $__interval_ms)::double precision AS \"TPS\"\nFROM scoring.scores\nWHERE $__timeFilter(scored_at)\n  AND ('__all__' IN (${us_state:sqlstring}) OR us_state IN (${us_state:sqlstring}))\n  AND ('__all__' IN (${merch:sqlstring}) OR merch IN (${merch:sqlstring}))\nGROUP BY 1\nORDER BY 1",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 9
    },
    {
      "title": "Доля фрода по категории за последние 1000 транзакций",
      "type": "barchart",
      "description": "Последние 1000 записей в PostgreSQL по времени публикации, независимо от диапазона дашборда.",
      "datasource": {
        "type": "postgres",
        "uid": "hw11-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hw11-postgres"
          },
          "rawSql": "WITH latest AS (\n    SELECT cat_id, fraud_flag\n    FROM scoring.scores\n    ORDER BY scored_at DESC, transaction_id DESC\n    LIMIT 1000\n)\nSELECT COALESCE(cat_id, 'Без категории') AS \"Категория\",\n       AVG(fraud_flag)::double precision AS \"Доля фрода\"\nFROM latest\nGROUP BY cat_id\nORDER BY AVG(fraud_flag) DESC, COALESCE(cat_id, 'Без категории')",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "xField": "Категория",
        "orientation": "auto",
        "xTickLabelRotation": -30,
        "groupWidth": 0.85,
        "barWidth": 0.92,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "showValue": "never"
      },
      "id": 10
    },
    {
      "title": "Средний скор у самых активных мерчантов",
      "type": "barchart",
      "description": "Десять мерчантов по числу транзакций в выбранном диапазоне. Средний скор помогает сравнить риск даже при редких фродовых флагах.",
      "datasource": {
        "type": "postgres",
        "uid": "hw11-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "hw11-postgres"
          },
          "rawSql": "SELECT merch AS \"Мерчант\", AVG(score) AS \"Средний скор\"\nFROM scoring.scores\nWHERE $__timeFilter(scored_at) AND merch IS NOT NULL\nGROUP BY merch\nORDER BY COUNT(*) DESC, merch\nLIMIT 10",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "xField": "Мерчант",
        "orientation": "auto",
        "xTickLabelRotation": -30,
        "groupWidth": 0.85,
        "barWidth": 0.92,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "showValue": "never"
      },
      "id": 11
    }
  ]
