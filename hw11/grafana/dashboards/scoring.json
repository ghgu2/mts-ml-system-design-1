    {
      "title": "Распределение скоров во времени",
      "type": "heatmap",
      "description": "Число скоров в каждом интервале значений за последние 30 секунд.",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
